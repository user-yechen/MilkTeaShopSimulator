# ============================================================
# 奶茶店项目 .gitignore（Unity 2022.3）
# 原则：Assets / ProjectSettings / Packages / Docs 必须进库；
#       Library 等自动生成目录（约 5.4 GB）不进库。
# ============================================================

# ---- Unity 自动生成 ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# ---- IDE / 编译产物 ----
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- 本项目临时文件 ----
.screenshots/

# 旧编译产物（脚本本体在 Assets/脚本/CounterCupDisplay.cs）
/CounterCupDisplay.dll

# ---- 出包 ----
*.apk
*.aab
*.unitypackage

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# Tripo / Blender 原始输出（体积大，不入库）
ArtSource/3D/raw/
模型测试/**/raw/

# 训练素材：只提交 README / 归纳 / 清单，媒体文件不入库
训练素材/**/*.wav
训练素材/**/*.mp3
训练素材/**/*.flac
训练素材/**/*.ogg
训练素材/**/*.m4a
训练素材/**/*.png
训练素材/**/*.jpg
训练素材/**/*.jpeg
训练素材/**/*.webp
训练素材/**/*.docx
训练素材/**/*.pdf

